# Copy this file to .env and fill in your own values:  cp .env.example .env

# ---------- LLM ----------
# Which provider LangChain should use: google_genai (Gemini) | ollama
LLM_PROVIDER=google_genai
# Model name for that provider. Gemini: gemini-3.5-flash-lite  |  Ollama: qwen2.5:3b
LLM_MODEL=gemini-3.5-flash-lite
# Free Gemini tiers have small DAILY quotas per model. When one runs out, these are tried in order.
# (See which models your key can use: uv run python scripts/check_llm.py --list-models)
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash
# Free Gemini keys have low per-minute limits. The agent waits so it stays under this.
LLM_REQUESTS_PER_MINUTE=10

# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Bright Data ----------
# Account settings -> API tokens at https://brightdata.com/cp/setting/users
BRIGHTDATA_API_TOKEN=
# The SDK creates these zones automatically on first use if they don't exist.
BRIGHTDATA_SERP_ZONE=sdk_serp
BRIGHTDATA_UNLOCKER_ZONE=sdk_unlocker
# Hard stop: max paid Bright Data requests in one run (cached calls are free).
MAX_CREDITS_PER_RUN=200

# ---------- Cache ----------
# How long search results / scraped pages are reused before fetching again.
CACHE_TTL_HOURS=72

# ---------- Agent behaviour ----------
# Leads scoring below this (1-10) are saved as "low fit" and hidden from results.
MIN_FIT_SCORE=6
# How many extra search rounds the agent may do when it hasn't found enough leads.
MAX_SEARCH_ROUNDS=4
# How many leads are researched at the same time.
MAX_CONCURRENCY=4
LOG_LEVEL=INFO
# true = use a fake LLM and fake search results (try everything without API keys)
DEMO_MODE=false

# ---------- Storage ----------
# Default is a local SQLite file at data/leads.db. Example Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/leads
# DATABASE_URL=

# ---------- Web app (API + worker) — only needed for `docker compose up` / uvicorn ----------
REDIS_URL=redis://localhost:6379/0
# API requests allowed per API key per minute, and agent runs per key per hour.
RATE_LIMIT_PER_MINUTE=60
RUNS_PER_HOUR=10
# Frontend URLs allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
